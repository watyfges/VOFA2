#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VOFA_VERSION_COMMA@
 PRODUCTVERSION @VOFA_VERSION_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "VOFA2"
            VALUE "FileDescription", "VOFA2 串口示波器"
            VALUE "FileVersion", "@VOFA_VERSION@"
            VALUE "InternalName", "vofa2_app"
            VALUE "OriginalFilename", "vofa2_app.exe"
            VALUE "ProductName", "VOFA2"
            VALUE "ProductVersion", "@VOFA_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
